let {assert} = import "../../aok/index.eyg"
let skills = import "../skills.eyg"

let test_parse_frontmatter = (_) -> {
  let skill = skills.parse("---\nname: release\ndescription: Cut a release.\n---\nSteps", "dir")
  let _ = assert.equal_string("release", skill.name)
  let _ = assert.equal_string("Cut a release.", skill.description)
  let _ = assert.equal_string("Steps", skill.body)
  {}
}

let test_parse_without_frontmatter = (_) -> {
  let skill = skills.parse("Just text", "dir")
  let _ = assert.equal_string("dir", skill.name)
  let _ = assert.equal_string("", skill.description)
  let _ = assert.equal_string("Just text", skill.body)
  {}
}

let test_read_and_print = (_) -> {
  let cwd = match perform CWD({}) {
    Ok(cwd) -> { cwd }
    Error(_) -> { perform Abort("no cwd") }
  }
  let root = !string_append(cwd, "/eyg_packages/overlay/fixtures/project")
  let found = skills.read(root)
  let names = !list_fold(found, [], (skill, acc) -> { [skill.name, ..acc] })
  let _ = assert.contains(names, "changelog")
  let _ = assert.contains(names, "plain")
  let printed = skills.print(found)
  let _ = assert.ok(!string_split_once(printed, "- changelog: How to write CHANGELOG entries.\n"))
  let _ = assert.equal_string("", skills.print([]))
  let _ = assert.equal([], skills.read(!string_append(cwd, "/eyg_packages/overlay/fixtures/none")))
  {}
}

[
  {name: "skills parse frontmatter", test: test_parse_frontmatter},
  {name: "skills parse without frontmatter", test: test_parse_without_frontmatter},
  {name: "skills read and print", test: test_read_and_print}
]
