let readme = "# json

JSON parsing and encoding.

## Decoding

```eyg
let {decode: d, parse} = @json
let decoder = d.object(
  d.field(\"name\", d.string)
)
match parse(\"{\\\"name\\\":\\\"Ada\\\"}\", decoder) {
  Ok(name) -> { name }
  Error(reason) -> { reason }
}
```

All decoders:

- decode.boolean
- decode.integer
- decode.string
- decode.list(item_decoder)
- decode.field(label, value_decoder)
- decode.object(decoder_fn)

use `parse(input, decoder)` for strings and `parse_bytes` for binary data.

## Encoding

```eyg
let json = @json
let e = json.encode

let payload = e.object([
  e.field(\"name\", e.string(\"Ada\")),
  e.field(\"age\", e.integer(36)),
])
// -> \"{\\\"name\\\":\\\"Ada\\\",\\\"age\\\":36}\"
```
"

let abort = (reason) -> {
  !never(perform Abort(reason))
}

let move = (from, to) -> {
  !list_fold(from, to, (item, acc) -> { [item, ..acc] }) 
}

let take = (parsed) -> {
  match !list_pop(parsed) {
    Ok({head, tail}) -> { {head, tail} }
    Error(_) -> { abort("Unexpected end of JSON") }
  }
}

let drop = !fix((self, parsed, under) -> {
  match !list_pop(parsed) {
    Ok({head, tail}) -> {
      match !int_compare(head.depth, under) {
        Gt(_) -> { self(tail, under) }
        Eq(_) -> { parsed }
        Lt(_) -> { parsed }
      }
    }
    Error(_) -> { [] }
  }
})

let boolean = (parsed) -> {
  let {head, tail} = take(parsed)
  match head.term {
    True(_) -> { {value: True({}), rest: tail} }
    False(_) -> { {value: False({}), rest: tail} }
    | (_) -> { abort("Expected boolean") }
  }
}

let integer = (parsed) -> {
  let {head, tail} = take(parsed)
  match head.term {
    Integer(value) -> { {value, rest: tail} }
    | (_) -> { abort("Expected integer") }
  }
}

let string = (parsed) -> {
  let {head, tail} = take(parsed)
  match head.term {
    String(value) -> { {value, rest: tail} }
    | (_) -> { abort("Expected string") }
  }
}

let list = (item_decoder) -> {
  (parsed) -> {
    let {head, tail} = take(parsed)
    match head.term {
      Array(_) -> {
        let under = head.depth
        let read_items = !fix((self, rest, acc) -> {
          match !list_pop(rest) {
            Ok({head, tail}) -> {
              match !int_compare(head.depth, under) {
                Gt(_) -> {
                  let decoded = item_decoder(rest)
                  self(decoded.rest, [decoded.value, ..acc])
                }
                Eq(_) -> { {value: move(acc, []), rest} }
                Lt(_) -> { {value: move(acc, []), rest} }
              }
            }
            Error(_) -> { {value: move(acc, []), rest} }
          }
        })
        read_items(tail, [])
      }
     | (_) -> { abort("Expected list") }
    }
  }
}

let do_field = !fix((self, parsed, at, seek) -> {
  match !list_pop(parsed) {
    Ok({head, tail}) -> {
      match !int_compare(head.depth, at) {
        Lt(_) -> { Error(seek) }
        Eq(_) -> {
          match head.term {
            Field(label) -> {
              match !equal(label, seek) {
                True(_) -> { Ok(tail) }
                False(_) -> { self(tail, at, seek) }
              }
            }
           | (_) -> { self(tail, at, seek) }
          }
        }
        Gt(_) -> { self(tail, at, seek) }
      }
    }
    Error(_) -> { Error(seek) }
  }
})

let field = (label, decoder) -> {
  (parsed) -> {
    let {head} = take(parsed)
    match do_field(parsed, head.depth, label) {
      Ok(rest) -> { decoder(rest).value }
      Error(_) -> { abort("Missing field") }
    }
  }
}

let object = (decoder) -> {
  (parsed) -> {
    let {head, tail} = take(parsed)
    match head.term {
      Object(_) -> { {value: decoder(tail), rest: drop(tail, head.depth)} }
      | (_) -> { abort("Expected object") }
    }
  }
}

let parse_bytes = (json, decoder) -> {
  match perform DecodeJSON(json) {
    Ok(flat) -> { handle Abort(
      (message,_resume) -> { Error(message) },
      (_) -> { Ok(decoder(flat).value) }
    ) }
    Error(reason) -> { Error(reason) }
  }
}

let parse = (json, decoder) -> {
  parse_bytes(!string_to_binary(json), decoder)
}

let decode = {
  boolean,
  integer,
  string,
  list,
  field,
  object
}

let encode = import "./encode.eyg"

{
  readme,
  parse,
  parse_bytes,
  decode,
  encode
}
