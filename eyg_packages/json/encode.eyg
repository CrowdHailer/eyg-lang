// JSON encoder.
//
// Each encoder returns a `String` of valid JSON. Compose them to
// build complex documents:
//
//     let person = encode.object([
//       {key: "name",  value: encode.string("Ada")},
//       {key: "age",   value: encode.integer(36)},
//       {key: "admin", value: encode.boolean(True({}))}
//     ])
//
// The result strings are pure values - no effects, no parser
// required. Round-trips through `decode` are tested in
// ../json/test.eyg.

let string_helpers = @standard:1:baguqeerahlbgfg7wjjdjguypivmsdcvh3e2vs4lhiafdbbtl3duxfuzv2eja.string

let hex_digit = (n) -> {
  match !int_compare(n, 10) {
    Lt(_) -> { !int_add(48, n) }
    | (_) -> { !int_add(87, n) }
  }
}

// Escape every control byte while retaining complete UTF-8 byte sequences.
let escape = (value) -> {
  let reversed = !binary_fold(!string_to_binary(value), [], (byte, acc) -> {
    match !int_compare(byte, 32) {
      Lt(_) -> {
        match !equal(byte, 10) {
          True(_) -> { [110, 92, ..acc] }
          False(_) -> {
            match !equal(byte, 13) {
              True(_) -> { [114, 92, ..acc] }
              False(_) -> {
                match !equal(byte, 9) {
                  True(_) -> { [116, 92, ..acc] }
                  False(_) -> {
                    let high = match !int_compare(byte, 16) { Lt(_) -> { 0 } | (_) -> { 1 } }
                    let low = !int_subtract(byte, !int_multiply(high, 16))
                    [hex_digit(low), hex_digit(high), 48, 48, 117, 92, ..acc]
                  }
                }
              }
            }
          }
        }
      }
      | (_) -> {
        match !equal(byte, 34) {
          True(_) -> { [34, 92, ..acc] }
          False(_) -> {
            match !equal(byte, 92) {
              True(_) -> { [92, 92, ..acc] }
              False(_) -> { [byte, ..acc] }
            }
          }
        }
      }
    }
  })
  let bytes = !list_fold(reversed, [], (byte, acc) -> { [byte, ..acc] })
  match !string_from_binary(!binary_from_integers(bytes)) {
    Ok(text) -> { text }
    Error(_) -> { "" }
  }
}

let quote = (value) -> {
  !string_append("\"", !string_append(escape(value), "\""))
}

let string = (value) -> { quote(value) }

let integer = (value) -> { !int_to_string(value) }

let boolean = (value) -> {
  match value {
    True(_) -> { "true" }
    False(_) -> { "false" }
  }
}

let null = (_) -> { "null" }

let join = (items, separator) -> {
  match !list_pop(items) {
    Ok({head, tail}) -> {
      !list_fold(tail, head, (item, acc) -> {
        !string_append(acc, !string_append(separator, item))
      })
    }
    Error(_) -> { "" }
  }
}

// Array of already-encoded strings. Each entry must itself be valid
// JSON (typically produced by the other encoders in this module).
let array = (items) -> {
  !string_append("[", !string_append(join(items, ","), "]"))
}

// {key, value} entry for object/.
let field = (key, value) -> { {key, value} }

let object = (fields) -> {
  let pairs = @standard:1:baguqeerahlbgfg7wjjdjguypivmsdcvh3e2vs4lhiafdbbtl3duxfuzv2eja.list.map(fields, ({key, value}) -> {
    !string_append(quote(key), !string_append(":", value))
  })
  !string_append("{", !string_append(join(pairs, ","), "}"))
}

{
  string,
  integer,
  boolean,
  null,
  array,
  object,
  field
}
