// Channel shell policies.
//
// A channel shell is the policy for every program run from a channel:
// programs people post, programs the channel's agent runs and anything the channel starts.
// It is a record with a gate function for each effect the channel may use.
// Every field is required and checked when the policy is set.
// Start from reject_all and overwrite the gates that should allow effects.
//
// Gates receive the effect's value and return `Pass(value)` to perform the effect,
// possibly with a changed value, or `Mock(value)` to return a value without performing it.
// Gates are pure, they cannot perform effects.

let policy = import "../overlay/policy.eyg"
let platform = import "./platform.eyg"
let reject_all = platform.reject_all
let pass = policy.pass

// Every effect available on the cloud, each performed unchanged.
// Start from this record and overwrite the fields to restrict.
// File paths given to gates are absolute paths in the workspace's shared file system.
let everything = {
  add_trigger: pass,
  append_file: pass,
  artifact: pass,
  cancel_schedule: pass,
  cron: pass,
  cwd: pass,
  delegate: pass,
  delete_file: pass,
  delete_trigger: pass,
  env: pass,
  events: pass,
  fetch: pass,
  flip: pass,
  list_triggers: pass,
  make_directory: pass,
  now: pass,
  post: pass,
  random: pass,
  read_directory: pass,
  read_file: pass,
  share_artifact: pass,
  sleep: pass,
  standard_error: pass,
  standard_out: pass,
  start_trigger: pass,
  stop_trigger: pass,
  timeout: pass,
  write_file: pass,
  ..reject_all
}

// Reply with an error instead of performing an effect.
let deny = policy.deny

// No network access, everything else is allowed.
let offline = {
  fetch: deny("fetch denied by channel shell"),
  ..everything
}

let request_path = (request) -> {
  request.path
}

let path = (path) -> {
  path
}

// Allow changes to the file system only under the absolute roots, other gates are from `shell`.
// Reads are unchanged, so the channel can read the whole shared file system.
let writes_under = (roots, shell) -> {
  {
    append_file: policy.under("append_file", roots, request_path),
    delete_file: policy.under("delete_file", roots, path),
    make_directory: policy.under("make_directory", roots, path),
    write_file: policy.under("write_file", roots, request_path),
    ..shell
  }
}

// Everything except changing files.
let read_only = writes_under([], everything)

// Read the cloud's configuration with the configuration API, see guides/cloud/api.md.
let observe = {
  workspaces: pass,
  workspace_source: pass,
  channels: pass,
  connections: pass,
  workspace_triggers: pass,
  secrets: pass,
  users: pass,
  shells: pass,
  ..reject_all
}

// Change the cloud's configuration, for admins and trusted channels such as a founders channel.
let configure = {
  workspaces: pass,
  workspace_source: pass,
  channels: pass,
  connections: pass,
  workspace_triggers: pass,
  secrets: pass,
  users: pass,
  shells: pass,
  set_workspace_source: pass,
  set_secret: pass,
  delete_secret: pass,
  set_user_shell: pass,
  ..reject_all
}

// Every channel effect and the configuration API, for a trusted channel such as #founders.
let admin = {
  add_trigger: pass,
  append_file: pass,
  artifact: pass,
  cancel_schedule: pass,
  channels: pass,
  connections: pass,
  cron: pass,
  cwd: pass,
  delegate: pass,
  delete_file: pass,
  delete_secret: pass,
  delete_trigger: pass,
  env: pass,
  events: pass,
  fetch: pass,
  flip: pass,
  list_triggers: pass,
  make_directory: pass,
  now: pass,
  post: pass,
  random: pass,
  read_directory: pass,
  read_file: pass,
  secrets: pass,
  set_secret: pass,
  set_user_shell: pass,
  set_workspace_source: pass,
  share_artifact: pass,
  shells: pass,
  sleep: pass,
  standard_error: pass,
  standard_out: pass,
  start_trigger: pass,
  stop_trigger: pass,
  timeout: pass,
  users: pass,
  workspace_source: pass,
  workspace_triggers: pass,
  workspaces: pass,
  write_file: pass,
  ..reject_all
}

let includes = (items, item) -> {
  !list_fold(items, False({}), (each, found) -> {
    match found {
      True(_) -> { True({}) }
      False(_) -> { !equal(each, item) }
    }
  })
}

// A web shell gate that binds only to the named channels.
let bind_to = (channels) -> {
  (target) -> {
    match includes(channels, target.channel) {
      True(_) -> { Pass(target) }
      False(_) -> { Mock(Error(!string_append("binding to #", !string_append(target.channel, " is not allowed")))) }
    }
  }
}

// Computation without access to anything outside the shell.
let pure = {
  now: pass,
  random: pass,
  flip: pass,
  standard_out: pass,
  standard_error: pass,
  ..reject_all
}

{
  reject_all,
  everything,
  read_only,
  observe,
  configure,
  admin,
  bind_to,
  pure,
  writes_under,
  offline,
  deny,
  pass,
  fetch_hosts: policy.fetch_hosts,
  with_header: policy.with_header
}
