// Each handler receives the native EYG type published by its plugin.
// The result is a list of work requests. A custom handler can return any subset.
let thread = (parent, id) -> {
  match parent { Some(_) -> { parent } None(_) -> { Some(id) } }
}
let submit = (channel, session, id, author, text) -> {
  let reply = thread(session, id)
  let suffix = match session {
    Some(id) -> { !string_append(", in the thread started by message ", id) }
    None(_) -> { "" }
  }
  let description = !list_fold([
    "[#", channel, suffix, "] ", author, " (message ", id, "): ", text
  ], "", (part, acc) -> { !string_append(acc, part) })
  [Trigger(reply), Submit({session, reply, text, description})]
}

let chat = (info) -> {
  match {
    ChatPosted(message) -> {
      match !equal(message.author.id, "cloud") {
        True(_) -> { [] }
        False(_) -> { submit(info.name, message.thread, message.id, message.author.name, message.text) }
      }
    }
    ChatReacted(reaction) -> {
      match !equal(reaction.by.id, "cloud") {
        True(_) -> { [] }
        False(_) -> { [Trigger(thread(reaction.message.thread, reaction.message.id))] }
      }
    }
  }
}

let slack = (info) -> {
  match {
    SlackMessage(event) -> {
      match event.is_self {
        True(_) -> { [] }
        False(_) -> {
          let user = match event.message.user { Some(id) -> { id } None(_) -> { "" } }
          let author = !string_append("<@", !string_append(user, ">"))
          let text = !string_replace(!string_replace(!string_replace(event.message.text, "&lt;", "<"), "&gt;", ">"), "&amp;", "&")
          submit(info.name, event.thread_ts, event.message.ts, author, text)
        }
      }
    }
    SlackReaction(event) -> {
      match event.is_self {
        True(_) -> { [] }
        False(_) -> { [Trigger(thread(event.thread_ts, event.message.ts))] }
      }
    }
  }
}

let discord = (info) -> {
  match {
    DiscordMessage(event) -> {
      match event.is_self {
        True(_) -> { [] }
        False(_) -> {
          let author = !string_append("<@", !string_append(event.message.author.id, ">"))
          submit(info.name, event.thread, event.message.id, author, event.message.content)
        }
      }
    }
    DiscordReaction(event) -> {
      match event.is_self {
        True(_) -> { [] }
        False(_) -> { [Trigger(thread(event.thread, event.message.id))] }
      }
    }
  }
}

let whatsapp = (info) -> {
  match {
    WhatsAppMessage(event) -> {
      let message = event.message
      match message.content {
        Reaction(reaction) -> { [Trigger(Some(reaction.message_id))] }
        | (content) -> {
          let text = match content {
            Text(text) -> { text }
            Button(button) -> { button.text }
            Interactive(reply) -> { reply.title }
            Media(media) -> {
              let kind = !string_append("[", !string_append(media.type, "]"))
              match !equal(media.caption, "") {
                True(_) -> { kind }
                False(_) -> { !string_append(kind, !string_append(" ", media.caption)) }
              }
            }
            Other(kind) -> { !string_append("[", !string_append(kind, "]")) }
          }
          let author = match message.name { Some(name) -> { name } None(_) -> { message.from } }
          submit(info.name, None({}), message.id, author, text)
        }
      }
    }
  }
}

let for_channel = (info) -> {
  match !equal(info.platform, "chat") {
    True(_) -> { chat(info) }
    False(_) -> {
      match !equal(info.platform, "slack") {
        True(_) -> { slack(info) }
        False(_) -> {
          match !equal(info.platform, "discord") {
            True(_) -> { discord(info) }
            False(_) -> {
              match !equal(info.platform, "whatsapp") {
                True(_) -> { whatsapp(info) }
                False(_) -> { (_) -> { [] } }
              }
            }
          }
        }
      }
    }
  }
}

{chat, slack, discord, whatsapp, for_channel}
