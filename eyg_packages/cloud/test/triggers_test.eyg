let {assert} = @aok
let triggers = import "../triggers.eyg"

let message = (text) -> { {id: "m1", channel: "general", thread: None({}), text, author: {id: "U1", name: "alice", bot: False({})}} }

let posted = (text) -> { ChatPosted(message(text)) }

let reacted = (text, emoji) -> {
  ChatReacted({message: message(text), emoji, by: {id: "U2", name: "bob", bot: False({})}})
}

let issue = (action) -> {
  GitHubIssue({connection: "github", repository: "eyg/eyg", actor: "alice", url: "", action, number: 1, title: "Bug", body: "", labels: []})
}

let pull = (action, merged) -> {
  GitHubPullRequest({connection: "github", repository: "eyg/eyg", actor: "alice", url: "", action, number: 2, title: "Fix", body: "", merged, branch: "fix", base: "main"})
}

let story = (title) -> {
  HackerNewsStory({connection: "hn", list: "top", id: 1, title, url: "", link: "", by: "pg", score: 1, comments: 0})
}

let request = (path, fields) -> {
  WebhookRequest({connection: "logs", method: "POST", path, query: [], headers: [], body: "", fields})
}

let sentry_issue = (action) -> {
  SentryIssue({connection: "sentry", action, id: "1", short_id: "APP-1", title: "TypeError", culprit: "", level: "error", status: "unresolved", project: "app", url: ""})
}

let sentry_alert = (action) -> {
  SentryAlert({connection: "sentry", kind: "metric_alert", action, rule: "Errors", title: "Errors high", level: action, url: ""})
}

let test_posted = (_) -> {
  let _ = assert.equal(True({}), triggers.posted(posted("hi")))
  let _ = assert.equal(False({}), triggers.posted(reacted("hi", "books")))
  {}
}

let test_reaction = (_) -> {
  let books = triggers.reaction("books")
  let _ = assert.equal(True({}), books(reacted("hi", "books")))
  let _ = assert.equal(False({}), books(reacted("hi", "eyes")))
  let _ = assert.equal(False({}), books(posted("books")))
  {}
}

let test_contains = (_) -> {
  let please = triggers.contains("please")
  let _ = assert.equal(True({}), please(posted("yes please")))
  let _ = assert.equal(False({}), please(posted("no thanks")))
  let _ = assert.equal(False({}), please(reacted("yes please", "books")))
  {}
}

let test_native_platforms = (_) -> {
  let slack = SlackMessage({message: {text: "yes please"}})
  let discord = DiscordMessage({message: {content: "yes please"}})
  let _ = assert.equal(True({}), triggers.posted(slack))
  let _ = assert.equal(True({}), triggers.posted(discord))
  let _ = assert.equal(True({}), triggers.contains("please")(slack))
  let _ = assert.equal(True({}), triggers.contains("please")(discord))
  let _ = assert.equal(True({}), triggers.reaction("books")(SlackReaction({reaction: "books"})))
  let _ = assert.equal(True({}), triggers.reaction("📚")(DiscordReaction({emoji: "📚"})))
  let _ = assert.equal(False({}), triggers.reaction("books")(DiscordReaction({emoji: "📚"})))
  {}
}

let test_whatsapp = (_) -> {
  let event = (content) -> { WhatsAppMessage({message: {content}}) }
  let _ = !list_fold([
    Text("yes please"), Button({text: "yes please"}), Interactive({title: "yes please"}),
    Media({caption: "yes please"})
  ], {}, (content, _) -> {
    let _ = assert.equal(True({}), triggers.posted(event(content)))
    assert.equal(True({}), triggers.contains("please")(event(content)))
  })
  let reaction = event(Reaction({message_id: "m1", emoji: "📚"}))
  let _ = assert.equal(False({}), triggers.posted(reaction))
  let _ = assert.equal(False({}), triggers.contains("please")(reaction))
  let _ = assert.equal(False({}), triggers.contains("please")(event(Other("location"))))
  let _ = assert.equal(True({}), triggers.reaction("📚")(reaction))
  let _ = assert.equal(False({}), triggers.reaction("books")(reaction))
  let _ = assert.equal(False({}), triggers.reaction("📚")(event(Text("📚"))))
  {}
}

let test_issue_opened = (_) -> {
  let _ = assert.equal(True({}), triggers.issue_opened(issue("opened")))
  let _ = assert.equal(False({}), triggers.issue_opened(issue("closed")))
  let _ = assert.equal(False({}), triggers.issue_opened(posted("opened")))
  {}
}

let test_pull_request_merged = (_) -> {
  let _ = assert.equal(True({}), triggers.pull_request_merged(pull("closed", True({}))))
  let _ = assert.equal(False({}), triggers.pull_request_merged(pull("closed", False({}))))
  let _ = assert.equal(False({}), triggers.pull_request_merged(pull("opened", False({}))))
  {}
}

let test_title_contains = (_) -> {
  let gleam = triggers.title_contains("Gleam")
  let _ = assert.equal(True({}), gleam(story("Why I like gleam")))
  let _ = assert.equal(False({}), gleam(story("Rust 2.0")))
  let _ = assert.equal(False({}), gleam(posted("gleam")))
  {}
}

let test_field_equals = (_) -> {
  let not_found = triggers.field_equals("status", "404")
  let _ = assert.equal(True({}), not_found(request("/", [{path: "path", value: "/x"}, {path: "status", value: "404"}])))
  let _ = assert.equal(False({}), not_found(request("/", [{path: "status", value: "200"}])))
  let _ = assert.equal(False({}), not_found(request("/", [])))
  let _ = assert.equal(False({}), not_found(posted("404")))
  {}
}

let test_webhook_path = (_) -> {
  let errors = triggers.webhook_path("/errors")
  let _ = assert.equal(True({}), errors(request("/errors", [])))
  let _ = assert.equal(False({}), errors(request("/", [])))
  {}
}

let test_sentry = (_) -> {
  let created = triggers.sentry_issue("created")
  let _ = assert.equal(True({}), created(sentry_issue("created")))
  let _ = assert.equal(False({}), created(sentry_issue("resolved")))
  let _ = assert.equal(True({}), triggers.sentry_alert(sentry_alert("critical")))
  let _ = assert.equal(False({}), triggers.sentry_alert(sentry_alert("resolved")))
  let _ = assert.equal(False({}), triggers.sentry_alert(sentry_issue("created")))
  {}
}

[
  {name: "triggers retain native platform values", test: test_native_platforms},
  {name: "triggers preserve whatsapp content", test: test_whatsapp},
  {name: "triggers webhook field equals", test: test_field_equals},
  {name: "triggers webhook path", test: test_webhook_path},
  {name: "triggers sentry issues and alerts", test: test_sentry},
  {name: "triggers posted", test: test_posted},
  {name: "triggers reaction", test: test_reaction},
  {name: "triggers contains", test: test_contains},
  {name: "triggers issue opened", test: test_issue_opened},
  {name: "triggers pull request merged", test: test_pull_request_merged},
  {name: "triggers title contains", test: test_title_contains}
]
