let {assert} = @aok
let secrets = import "../secrets.eyg"

let expect_pass = (decision) -> {
  match decision {
    Pass(value) -> { value }
    Mock(_) -> { !never(perform Abort("expected Pass, got Mock")) }
  }
}

let expect_mock = (decision) -> {
  match decision {
    Mock(value) -> { value }
    Pass(_) -> { !never(perform Abort("expected Mock, got Pass")) }
  }
}

let token = secrets.secret("GITHUB_TOKEN", "ghp_real", ["api.github.com"], !binary_from_integers([1, 171]))

let request = (scheme, host, headers) -> {
  {
    method: GET({}),
    scheme,
    host,
    port: None({}),
    path: "/user",
    query: None({}),
    headers,
    body: !string_to_binary("")
  }
}

let pass = (request) -> { Pass(request) }

let test_hex = (_) -> {
  let _ = assert.equal_string("01ab", secrets.hex(!binary_from_integers([1, 171])))
  let _ = assert.equal_string("", secrets.hex(!binary_from_integers([])))
  {}
}

let test_env_returns_placeholder = (_) -> {
  let env = secrets.env([token])
  let _ = assert.equal(Some("eyg-secret-01ab"), expect_mock(env("GITHUB_TOKEN")))
  let _ = assert.equal(None({}), expect_mock(env("OTHER")))
  {}
}

let test_fetch_adds_authorization = (_) -> {
  let fetch = secrets.fetch([token], pass)
  let sent = expect_pass(fetch(request(HTTPS({}), "api.github.com", [])))
  let _ = assert.equal([{key: "authorization", value: "Bearer ghp_real"}], sent.headers)
  {}
}

let test_fetch_replaces_placeholders = (_) -> {
  let fetch = secrets.fetch([token], pass)
  let headers = [{key: "x-api-key", value: "eyg-secret-01ab"}]
  let sent = expect_pass(fetch(request(HTTPS({}), "api.github.com", headers)))
  let _ = assert.equal([{key: "x-api-key", value: "ghp_real"}], sent.headers)
  {}
}

let test_fetch_keeps_existing_authorization = (_) -> {
  let fetch = secrets.fetch([token], pass)
  let headers = [{key: "Authorization", value: "Basic other"}]
  let sent = expect_pass(fetch(request(HTTPS({}), "api.github.com", headers)))
  let _ = assert.equal(headers, sent.headers)
  {}
}

let test_fetch_other_hosts_unchanged = (_) -> {
  let fetch = secrets.fetch([token], pass)
  let headers = [{key: "authorization", value: "Bearer eyg-secret-01ab"}]
  let sent = expect_pass(fetch(request(HTTPS({}), "evil.example", headers)))
  let _ = assert.equal(headers, sent.headers)
  let plain = expect_pass(fetch(request(HTTP({}), "api.github.com", [])))
  let _ = assert.equal([], plain.headers)
  {}
}

let test_fetch_uses_otherwise = (_) -> {
  let deny = (_) -> { Mock(Error("denied")) }
  let fetch = secrets.fetch([token], deny)
  let _ = assert.equal_string("denied", assert.error(expect_mock(fetch(request(HTTPS({}), "api.github.com", [])))))
  {}
}

[
  {name: "secrets hex", test: test_hex},
  {name: "secrets env returns placeholder", test: test_env_returns_placeholder},
  {name: "secrets fetch adds authorization", test: test_fetch_adds_authorization},
  {name: "secrets fetch replaces placeholders", test: test_fetch_replaces_placeholders},
  {name: "secrets fetch keeps existing authorization", test: test_fetch_keeps_existing_authorization},
  {name: "secrets fetch leaves other hosts unchanged", test: test_fetch_other_hosts_unchanged},
  {name: "secrets fetch uses otherwise", test: test_fetch_uses_otherwise}
]
