let {assert} = @aok
let cloud = import "../index.eyg"
let shell = cloud.shell

let expect_pass = (decision) -> {
  match decision {
    Pass(value) -> { value }
    Mock(_) -> { !never(perform Abort("expected Pass, got Mock")) }
    Reject(_) -> { !never(perform Abort("expected Pass, got Reject")) }
  }
}

let expect_mock = (decision) -> {
  match decision {
    Mock(value) -> { value }
    Pass(_) -> { !never(perform Abort("expected Mock, got Pass")) }
    Reject(_) -> { !never(perform Abort("expected Mock, got Reject")) }
  }
}

let request = {
  method: GET({}),
  scheme: HTTPS({}),
  host: "example.com",
  port: None({}),
  path: "/",
  query: None({}),
  headers: [],
  body: !string_to_binary("")
}

let test_everything_passes = (_) -> {
  let s = shell.everything
  let _ = assert.equal_string("hi", expect_pass(s.post("hi")))
  let _ = assert.equal_string("out", expect_pass(s.standard_out("out")))
  let _ = assert.equal_string("KEY", expect_pass(s.env("KEY")))
  let _ = assert.equal_string("example.com", expect_pass(s.fetch(request)).host)
  {}
}

let test_offline_denies_fetch = (_) -> {
  let s = shell.offline
  let _ = assert.equal_string(
    "fetch denied by channel shell",
    assert.error(expect_mock(s.fetch(request)))
  )
  let _ = assert.equal_string("hi", expect_pass(s.post("hi")))
  {}
}

let expect_reject = (decision) -> {
  match decision {
    Reject(_) -> { {} }
    | (_) -> { !never(perform Abort("expected Reject")) }
  }
}

let test_defaults_reject_every_gate = (_) -> {
  let s = cloud.reject_all
  let _ = expect_reject(s.dataclip({name: "x", input: {}}))
  let _ = expect_reject(s.sqlite({database: "x", sql: "SELECT 1", parameters: []}))
  let _ = expect_reject(s.sqlite_query({database: "x", query: {}}))
  let _ = expect_reject(s.traces({workspace: "x", limit: 10}))
  let _ = expect_reject(s.bind({}))
  let _ = expect_reject(s.unbind({}))
  let _ = expect_reject(s.workspaces({}))
  let _ = expect_reject(s.workspace_source({}))
  let _ = expect_reject(s.set_workspace_source({}))
  let _ = expect_reject(s.channels({}))
  let _ = expect_reject(s.connections({}))
  let _ = expect_reject(s.workspace_triggers({}))
  let _ = expect_reject(s.secrets({}))
  let _ = expect_reject(s.set_secret({}))
  let _ = expect_reject(s.delete_secret({}))
  let _ = expect_reject(s.users({}))
  let _ = expect_reject(s.shells({}))
  let _ = expect_reject(s.set_user_shell({}))
  let _ = expect_reject(s.events("github"))
  let _ = expect_reject(s.artifact({name: "x", bundle: []}))
  let _ = expect_reject(s.share_artifact("x"))
  let _ = expect_reject(s.cancel_schedule("x"))
  let _ = expect_reject(s.cron({name: "x", schedule: "* * * * *", message: "hello"}))
  let _ = expect_reject(s.timeout({name: "x", after: 100, message: "hello"}))
  let _ = expect_reject(s.add_trigger({name: "x", pattern: (_) -> { True({}) }, script: (_) -> { {} }}))
  let _ = expect_reject(s.start_trigger("x"))
  let _ = expect_reject(s.stop_trigger("x"))
  let _ = expect_reject(s.delete_trigger("x"))
  let _ = expect_reject(s.list_triggers({}))
  let _ = expect_reject(s.delegate("task"))
  let _ = expect_reject(s.append_file({path: "/a", contents: !string_to_binary("x")}))
  let _ = expect_reject(s.cwd({}))
  let _ = expect_reject(s.delete_file("/a"))
  let _ = expect_reject(s.make_directory("/a"))
  let _ = expect_reject(s.read_directory("/"))
  let _ = expect_reject(s.read_file({path: "/a", offset: 0, limit: 100}))
  let _ = expect_reject(s.write_file({path: "/a", contents: !string_to_binary("x")}))
  let _ = expect_reject(s.env("KEY"))
  let _ = expect_reject(s.fetch(request))
  let _ = expect_reject(s.flip({}))
  let _ = expect_reject(s.now({}))
  let _ = expect_reject(s.post("hello"))
  let _ = expect_reject(s.random(10))
  let _ = expect_reject(s.sleep(0))
  let _ = expect_reject(s.standard_error("error"))
  let _ = expect_reject(s.standard_out("out"))
  {}
}

let write = (path) -> {
  {path, contents: !string_to_binary("x")}
}

let test_writes_under = (_) -> {
  let s = shell.writes_under(["/channels/general"], shell.everything)
  let _ = assert.equal_string("/channels/general/a.txt", expect_pass(s.write_file(write("/channels/general/a.txt"))).path)
  let _ = assert.equal_string(
    "write_file denied by policy: /skills/a.md",
    assert.error(expect_mock(s.write_file(write("/skills/a.md"))))
  )
  let _ = assert.error(expect_mock(s.delete_file("/channels/random")))
  let _ = assert.error(expect_mock(s.make_directory("/other")))
  let _ = assert.equal_string("/skills/a.md", expect_pass(s.read_file({path: "/skills/a.md", offset: 0, limit: 10})).path)
  {}
}

let test_read_only = (_) -> {
  let s = shell.read_only
  let _ = assert.error(expect_mock(s.write_file(write("/a.txt"))))
  let _ = assert.equal_string("/", expect_pass(s.read_directory("/")))
  {}
}

let test_admin_has_channel_and_api_effects = (_) -> {
  let _ = assert.equal_string("hi", expect_pass(shell.admin.post("hi")))
  let _ = assert.equal_string("demo", expect_pass(shell.admin.set_workspace_source("demo")))
  {}
}

let test_configure_includes_observe = (_) -> {
  let _ = assert.equal_string("demo", expect_pass(shell.configure.workspaces("demo")))
  let _ = assert.equal_string("demo", expect_pass(shell.configure.set_secret("demo")))
  {}
}

let test_bind_to = (_) -> {
  let gate = shell.bind_to(["random", "links"])
  let _ = assert.equal_string("random", expect_pass(gate({workspace: "w", channel: "random"})).channel)
  let _ = assert.equal_string(
    "binding to #general is not allowed",
    assert.error(expect_mock(gate({workspace: "w", channel: "general"})))
  )
  {}
}

let query = (database) -> {
  {database, sql: "SELECT 1", parameters: []}
}

let test_databases = (_) -> {
  let d = shell.databases(["errors"])
  let _ = assert.equal_string("errors", expect_pass(d.sqlite(query("errors"))).database)
  let _ = assert.equal_string(
    "database users is not allowed",
    assert.error(expect_mock(d.sqlite(query("users"))))
  )
  let _ = assert.error(expect_mock(d.sqlite_query({database: "users", query: {}})))
  let _ = assert.equal_string(
    "raw database access is not in this shell, use a dataclip",
    assert.error(expect_mock(shell.everything.sqlite(query("errors"))))
  )
  let trusted = shell.with_databases(["errors"], shell.everything)
  let _ = assert.equal_string("errors", expect_pass(trusted.sqlite(query("errors"))).database)
  let _ = assert.equal_string("hi", expect_pass(trusted.post("hi")))
  {}
}

let test_dataclips = (_) -> {
  let gate = shell.dataclips(["recent_errors"])
  let _ = assert.equal_string("recent_errors", expect_pass(gate({name: "recent_errors", input: {}})).name)
  let _ = assert.equal_string(
    "dataclip all_users is not allowed",
    assert.error(expect_mock(gate({name: "all_users", input: {}})))
  )
  let _ = assert.equal_string("recent_errors", expect_pass(shell.everything.dataclip({name: "recent_errors", input: {}})).name)
  {}
}

[
  {name: "cloud defaults reject every gate", test: test_defaults_reject_every_gate},
  {name: "cloud shell databases allows named databases", test: test_databases},
  {name: "cloud shell dataclips allows named dataclips", test: test_dataclips},
  {name: "cloud shell admin has channel and api effects", test: test_admin_has_channel_and_api_effects},
  {name: "cloud shell configure includes observe", test: test_configure_includes_observe},
  {name: "cloud shell bind to channels", test: test_bind_to},
  {name: "cloud shell everything passes", test: test_everything_passes},
  {name: "cloud shell writes under roots", test: test_writes_under},
  {name: "cloud shell read only", test: test_read_only},
  {name: "cloud shell offline denies fetch", test: test_offline_denies_fetch}
]
