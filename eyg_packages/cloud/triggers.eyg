// Patterns for triggers.
//
// A pattern is a pure function from an event to `True({})` or `False({})`.
// Events are tagged by kind, see guides/cloud/trigger_events.md.

let false = (_) -> { False({}) }

let posted = match {
  ChatPosted(_) -> { True({}) }
  SlackMessage(_) -> { True({}) }
  DiscordMessage(_) -> { True({}) }
  | false
}

let reaction = (emoji) -> {
  match {
    ChatReacted(event) -> { !equal(event.emoji, emoji) }
    SlackReaction(event) -> { !equal(event.reaction, emoji) }
    DiscordReaction(event) -> { !equal(event.emoji, emoji) }
    | false
  }
}

let includes = (text, part) -> {
  match !string_split_once(text, part) {
    Ok(_) -> { True({}) }
    Error(_) -> { False({}) }
  }
}

let contains = (text) -> {
  match {
    ChatPosted(message) -> { includes(message.text, text) }
    SlackMessage(event) -> { includes(event.message.text, text) }
    DiscordMessage(event) -> { includes(event.message.content, text) }
    | false
  }
}

// A GitHub issue opened in any connected repository.
let issue_opened = match {
  GitHubIssue(issue) -> { !equal(issue.action, "opened") }
  | false
}

// A GitHub pull request merged.
let pull_request_merged = match {
  GitHubPullRequest(pull) -> {
    match pull.merged {
      True(_) -> { !equal(pull.action, "closed") }
      False(_) -> { False({}) }
    }
  }
  | false
}

// A story or feed item whose title contains the text, from RSS, Hacker News or Lobsters.
let title_contains = (text) -> {
  let lower = !string_lowercase(text)
  let check = (title) -> { includes(!string_lowercase(title), lower) }
  match {
    FeedItem(item) -> { check(item.title) }
    HackerNewsStory(story) -> { check(story.title) }
    LobstersStory(story) -> { check(story.title) }
    | false
  }
}

{posted, reaction, contains, issue_opened, pull_request_merged, title_contains}
