let assert = import "../source/assert.eyg"
let expect = import "../source/expect.eyg"

let must_abort = (check) -> {
  let result = handle Abort((message, _resume) -> { Ok(message) }, (_) -> {
    Error(check({}))
  })
  assert.ok(result)
}

[
  {
    name: "pure test with no expected effects",
    test: (_) -> {
      let returned = expect.run((_) -> { !int_add(2, 1) }, [])
      let _ = assert.equal(3, returned)
      {}
    }
  },
  {
    name: "pure test with fails if effects expected",
    test: (_) -> {
      let program = (_) -> { !int_add(2, 1) }
      let message = must_abort((_) -> {
        expect.run(program, [
          expect.now((_lift) -> { 100 })
        ])
      })
      let _ = assert.equal_string("expected effect `Now`, given no effect", message)
      {}
    }
  },
  {
    name: "fails on effect when steps done",
    test: (_) -> {
      let program = (_) -> { !int_add(perform Now({}), 1) }
      let message = must_abort((_) -> {
        expect.run(program, [])
      })
      let _ = assert.equal_string("expected no effect, given effect `Now`", message)
      {}
    }
  },
  {
    name: "fails on unexpected effect",
    test: (_) -> {
      let program = (_) -> { perform StandardOut("hi") }
      let message = must_abort((_) -> {
        expect.run(program, [
          expect.now((_lift) -> { !never(perform Abort("check should not run")) })
        ])
      })
      let _ = assert.equal_string("expected effect `Now`, given effect `StandardOut`", message)
      {}
    }
  },
  {
    name: "reports extra effect after consuming expectations",
    test: (_) -> {
      let message = must_abort((_) -> {
        expect.run((_) -> {
          let _ = perform Now({})
          perform StandardOut("hi")
        }, [expect.now((_lift) -> { 100 })])
      })
      let _ = assert.equal_string("expected no effect, given effect `StandardOut`", message)
      {}
    }
  },
  {
    name: "reports next effect when expectations remain",
    test: (_) -> {
      let message = must_abort((_) -> {
        expect.run((_) -> { perform Now({}) }, [
          expect.now((_lift) -> { 100 }),
          expect.now((_lift) -> { 200 })
        ])
      })
      let _ = assert.equal_string("expected effect `Now`, given no effect", message)
      {}
    }
  },
  {
    name: "passes effect payload to check and resumes with reply",
    test: (_) -> {
      let returned = expect.run((_) -> { perform StandardOut("hi") }, [
        expect.standard_out((message) -> {
          let _ = assert.equal_string("hi", message)
          {}
        })
      ])
      let _ = assert.equal({}, returned)
      {}
    }
  },
  {
    name: "return value from expectations",
    test: (_) -> {
      let program = (_) -> { [perform Now({}), perform Now({}), perform Now({})] }
      let returned = expect.run(program, [
        expect.now((_lift) -> { 123 }),
        expect.now((_lift) -> { 456 }),
        expect.now((_lift) -> { 789 })
      ])
      let _ = assert.equal([123, 456, 789], returned)
      {}
    }
  }
]
