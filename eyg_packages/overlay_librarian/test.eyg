let {assert} = @aok
let context = import "./index.eyg"
let search = import "./search.eyg"

let names = (found) -> { search.map(found, (library) -> { library.name }) }
let slugs = (found) -> { search.map(found, (guide) -> { guide.slug }) }

let serve = (status, text) -> {
  (request, resume) -> {
    let _ = assert.equal_string("eyg.run", request.host)
    resume(Ok({status, headers: [], body: !string_to_binary(text), path: request.path}))
  }
}

[
  {name: "json is found for parsing an api response",
   test: (_) -> {
     let found = names(context.libraries.search("parse the JSON body of an api response"))
     assert.equal(found, ["json", "http"])
   }},
  {name: "edit is found for replacing text in a file",
   test: (_) -> {
     let {head} = assert.ok(!list_pop(context.libraries.search("replace text in a file")))
     assert.equal_string("edit", head.name)
   }},
  {name: "access policies are found for denying file writes",
   test: (_) -> {
     let {head} = assert.ok(!list_pop(context.libraries.search("deny file writes with a policy")))
     assert.equal_string("overlay", head.name)
   }},
  {name: "nothing is found for an unrelated query",
   test: (_) -> { assert.equal(context.libraries.search("zebra"), []) }},
  {name: "the syntax guide is found for match expressions",
   test: (_) -> {
     let {head} = assert.ok(!list_pop(context.guides.search("how do I write a match expression")))
     assert.equal_string("eyg-syntax-guide", head.slug)
   }},
  {name: "the effects reference is found for reading files on the cli",
   test: (_) -> {
     let {head} = assert.ok(!list_pop(context.guides.search("read a file with the cli")))
     assert.equal_string("cli-effects-reference", head.slug)
   }},
  {name: "guides are read from eyg.run",
   test: (_) -> {
     let result = handle Fetch(serve(200, "# JSON"), (_) -> { context.guides.read("json") })
     assert.equal(result, Ok("# JSON"))
   }},
  {name: "a missing guide is an error",
   test: (_) -> {
     let result = handle Fetch(serve(404, "Not found"), (_) -> { context.guides.read("nope") })
     assert.equal(result, Error("no guide with the slug nope"))
   }},
  {name: "guide errors preserve a failed fetch",
   test: (_) -> {
     let result = handle Fetch((_, resume) -> { resume(Error("offline")) }, (_) -> { context.guides.read("json") })
     assert.equal(result, Error("offline"))
   }},
  {name: "guides must be utf8 text",
   test: (_) -> {
     let result = handle Fetch((_, resume) -> { resume(Ok({status: 200, headers: [], body: !binary_from_integers([255])})) }, (_) -> { context.guides.read("json") })
     assert.equal(result, Error("the guide is not text"))
   }},
  {name: "every library has an example and every guide a summary",
   test: (_) -> {
     let _ = !list_fold(context.libraries.all, {}, (library, _) -> {
       assert.false(!equal(library.example, ""))
     })
     !list_fold(context.guides.all, {}, (guide, _) -> {
       assert.false(!equal(guide.summary, ""))
     })
   }}
]
