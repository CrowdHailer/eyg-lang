let c = import "./common.eyg"

let script = import "./runtime.eyg".carousel

let render = ({title, images}) -> {
  let built = !list_fold(images, {index: 0, figures: [], files: []}, (image, state) -> {
    let {index, figures, files} = state
    let path = !string_append("images/", !int_to_string(index))
    let figure = c.concat([
      "<figure hidden><img src=\"", path, "\" alt=\"", c.escape(image.caption), "\"><figcaption>",
      c.escape(image.caption),
      "</figcaption></figure>"
    ])
    let file = {path, media_type: image.media_type, content: image.content}
    {index: !int_add(index, 1), figures: [figure, ..figures], files: [file, ..files]}
  })
  let figures = !list_fold(built.figures, "", (figure, acc) -> { !string_append(figure, acc) })
  let body = c.concat([
    "<style>html,body{height:100%}body{display:flex;flex-direction:column;gap:8px;overflow:hidden;padding:12px}h1{font-size:18px;margin:0}figure:not([hidden]){display:flex;flex-direction:column;flex:1;min-height:0}figure img{flex:1;min-height:0;width:100%;object-fit:contain}figcaption{font-size:12px;flex:none}nav{flex:none;margin:0;font-size:12px}nav button{padding:4px 10px}</style>",
    figures,
    "<p id=\"empty\" hidden>No images supplied.</p><nav><button id=\"previous\" aria-label=\"Previous image\">←</button><span id=\"position\"></span><button id=\"next\" aria-label=\"Next image\">→</button></nav><script>",
    script,
    "</script>"
  ])
  [c.page(title, body), ..built.files]
}

{
  readme: "Image carousel bundle constructor. render({title: String, images: List({caption: String, media_type: String, content: Binary})}) returns an HTML artifact bundle. It is pure: no Fetch, Artifact or Show effects. Images must already be fetched or generated by the caller (e.g. image/svg+xml and !string_to_binary(svg)). Captions and title are HTML-escaped. Files receive deterministic images/0, images/1 paths, independent of caller filenames. Includes previous/next buttons, keyboard arrows, position indicator, wraparound, and an empty state. All images are in the initial HTML so the platform can embed their bytes; no runtime network. Example: perform Artifact({name: \"photos\", bundle: viewer.render({title: \"Route views\", images: [{caption: \"Map\", media_type: \"image/svg+xml\", content: !string_to_binary(svg)}]})}). Reference this module by its shared CID to select exactly this viewer implementation.",
  render
}
