let c = import "./common.eyg"
let render = ({title,images}) -> {
  let built = !list_fold(images,{index:0,figures:[],files:[]},({caption,media_type,content},{index,figures,files}) -> {
    let path = !string_append("images/",!int_to_string(index))
    let figure = c.concat(["<figure hidden><img src=\"",path,"\" alt=\"",c.escape(caption),"\"><figcaption>",c.escape(caption),"</figcaption></figure>"])
    {index:!int_add(index,1),figures:[figure,..figures],files:[{path,media_type,content},..files]}
  })
  let figures = !list_fold(built.figures,"",(figure,acc) -> { !string_append(figure,acc) })
  let body = c.concat([
    "<style>html,body{height:100%}body{display:flex;flex-direction:column;gap:8px;overflow:hidden;padding:12px}h1{font-size:18px;margin:0}figure:not([hidden]){display:flex;flex-direction:column;flex:1;min-height:0}figure img{flex:1;min-height:0;width:100%;object-fit:contain}figcaption{font-size:12px;flex:none}nav{flex:none;margin:0;font-size:12px}nav button{padding:4px 10px}</style>",figures,
    "<p id=\"empty\" hidden>No images supplied.</p><nav><button id=\"previous\" aria-label=\"Previous image\">←</button><span id=\"position\"></span><button id=\"next\" aria-label=\"Next image\">→</button></nav><script>const figures=[...document.querySelectorAll('figure')];let index=0;function show(){figures.forEach((figure,i)=>figure.hidden=i!==index);document.getElementById('position').textContent=figures.length?`${index+1} / ${figures.length}`:'0 / 0';document.getElementById('empty').hidden=figures.length>0;document.querySelectorAll('button').forEach(b=>b.disabled=figures.length<2)}document.getElementById('previous').onclick=()=>{index=(index+figures.length-1)%figures.length;show()};document.getElementById('next').onclick=()=>{index=(index+1)%figures.length;show()};document.addEventListener('keydown',e=>{if(e.key==='ArrowRight')document.getElementById('next').click();if(e.key==='ArrowLeft')document.getElementById('previous').click()});show();</script>"
  ])
  [c.page(title,body),..built.files]
}
{
  readme:"Image carousel bundle constructor. render({title:String,images:List({caption:String,media_type:String,content:Binary})}) returns an HTML artifact bundle. It is pure: no Fetch, Artifact or Show effects. Images must already be fetched or generated by the caller (e.g. image/svg+xml and !string_to_binary(svg)). Captions/title are HTML-escaped. Files receive deterministic images/0, images/1 paths, independent of caller filenames. Includes previous/next buttons, keyboard arrows, position indicator, wraparound, and an empty state. All images are in initial HTML so the platform can embed their bytes; no runtime network. Example: perform Artifact({name:\"photos\",bundle:viewer.render({title:\"Route views\",images:[{caption:\"Map\",media_type:\"image/svg+xml\",content:!string_to_binary(svg)}]})}). Reference this module by its shared CID to select exactly this viewer implementation.",
  render
}
