let c = import "./common.eyg"
let render = ({title,feed,retrieved_at}) -> {
  let safe_json = !string_replace(feed,"<","\\u003c")
  [c.page(title,c.concat([
    "<small>Bluesky · retrieved ",c.escape(retrieved_at),"</small><main id=\"posts\"></main><script id=\"feed\" type=\"application/json\">",safe_json,"</script>",
    "<script>const root=document.getElementById('posts');function text(tag,value,parent){const el=document.createElement(tag);el.textContent=String(value??'');parent.append(el);return el}try{const data=JSON.parse(document.getElementById('feed').textContent);if(!Array.isArray(data.feed))throw new Error('Expected app.bsky.feed.getAuthorFeed response');let count=0;for(const item of data.feed){const post=item?.post;const record=post?.record;if(record?.$type!=='app.bsky.feed.post')continue;count++;const card=document.createElement('article');text('strong',post.author?.displayName||post.author?.handle||'Unknown author',card);text('small',' @'+(post.author?.handle||'')+' · '+(record.createdAt||''),card);text('p',record.text,card);text('small',`${post.likeCount||0} likes · ${post.repostCount||0} reposts`,card);if(item.reason)text('small',' · Reposted',card);if(record.embed)text('p','[Post contains an attachment; this text viewer does not load remote media.]',card);root.append(card)}if(!count)text('p','No supported posts in this feed.',root)}catch(error){text('p','Unable to display feed: '+error.message,root)}</script>"
  ]))]
}
{
  readme:"Bluesky lexicon viewer bundle constructor. render({title:String,feed:String,retrieved_at:String}) returns a self-contained HTML bundle. feed is the UTF-8 JSON response from public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=<handle-or-DID>&limit=5; the calling EYG program performs Fetch and checks status before passing JSON. The viewer understands feed[].post records whose $type is app.bsky.feed.post, rendering author, handle, createdAt, text, like/repost counts, and repost/attachment notices. Unsupported record types are skipped; empty and malformed feeds have visible states. This example deliberately renders text only: avatars, attachments, rich facets, pagination and links are not fetched. All remote text is inserted via textContent; embedded JSON escapes < to prevent script termination. retrieved_at is supplied by the caller, not fabricated by the viewer. Pure: no network or platform effects. Example: perform Artifact({name:\"operator-posts\",bundle:viewer.render({title:\"Bus company updates\",feed:json,retrieved_at:timestamp})}). Its shared CID selects this application; the platform knows no Bluesky lexicons.",
  render
}
