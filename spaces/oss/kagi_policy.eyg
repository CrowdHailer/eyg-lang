// Kagi fetch policy helpers.
//
// Used by `.overlay.eyg` to attach the Kagi API bearer token to fetch
// requests for Kagi hosts. The token is passed in by the caller so it stays
// in the overlay configuration closure and out of client code.

let {policy} = @overlay

// Allow fetch requests with the Authorization header set for Kagi hosts.
// The documented v1 Search API is served from `kagi.com`; `api.kagi.com` is
// also authorised. Requests to any other host are passed to `otherwise`
// unchanged.
let with_kagi_auth = (token, otherwise) -> {
  policy.with_header(
    "api.kagi.com",
    "Authorization",
    !string_append("Bearer ", token),
    policy.with_header(
      "kagi.com",
      "Authorization",
      !string_append("Bearer ", token),
      otherwise
    )
  )
}

{with_kagi_auth}
