
let {ollama_token, kagi_api_key, hetzner_token} = import ".env.eyg"

let policy = @overlay.policy

let fetch_policy = 
  policy.with_header(
    "api.kagi.com",
    "Authorization",
    !string_append("Bearer ", kagi_api_key),
    policy.with_header(
      "kagi.com",
      "Authorization",
      !string_append("Bearer ", kagi_api_key),
      policy.with_header(
        "api.hetzner.cloud",
        "Authorization",
        !string_append("Bearer ", hetzner_token),
        policy.allow_all.fetch
      )
    )
  )

let policy = {
  fetch: fetch_policy,
  ..policy.allow_all
}

let expect = (result, message) -> {
  match result {
    Ok(value) -> { value }
    Error(_) -> { !never(perform Exit(1)) }
  }
}

let contents = expect(
  perform ReadFile({path: "./README.md", offset: 0, limit: 1000000}),
  "Could not read README.md"
)
let readme = expect(
  !string_from_binary(contents),
  "README.md is not valid UTF-8"
)
{
  llm: {
    provider: Ollama({origin: "https://ollama.com", api_key: Some(ollama_token)}),
    model: "glm-5.3:cloud"
  },
  policy: policy,
  context: {readme}
}
