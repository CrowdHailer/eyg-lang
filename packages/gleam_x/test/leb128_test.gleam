import gleam/list
import leb128

pub fn known_vectors_test() {
  [
    #(0, <<0>>),
    #(1, <<1>>),
    #(127, <<127>>),
    #(128, <<128, 1>>),
    #(129, <<129, 1>>),
    #(255, <<255, 1>>),
    #(16_383, <<255, 127>>),
    #(16_384, <<128, 128, 1>>),
    #(624_485, <<229, 142, 38>>),
    #(2_097_151, <<255, 255, 127>>),
    #(2_097_152, <<128, 128, 128, 1>>),
    #(268_435_455, <<255, 255, 255, 127>>),
    #(268_435_456, <<128, 128, 128, 128, 1>>),
    #(2_147_483_647, <<255, 255, 255, 255, 7>>),
    #(2_147_483_648, <<128, 128, 128, 128, 8>>),
    #(4_294_967_295, <<255, 255, 255, 255, 15>>),
    #(4_294_967_296, <<128, 128, 128, 128, 16>>),
    #(9_007_199_254_740_991, <<255, 255, 255, 255, 255, 255, 255, 15>>),
  ]
  |> list.each(fn(pair) {
    let #(value, bytes) = pair
    assert leb128.encode_unsigned(value) == Ok(bytes)
    assert leb128.decode_unsigned(bytes) == Ok(#(value, <<>>))
    assert leb128.decode_unsigned(<<bytes:bits, 255, 128, 0, 42>>)
      == Ok(#(value, <<255, 128, 0, 42>>))
  })
}
