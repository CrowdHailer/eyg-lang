{
  "scopeName": "markdown.eyg.codeblock",
  "injectionSelector": "L:text.html.markdown -markup.fenced_code.block.markdown",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.eyg",
      "begin": "^[ \\t]*(`{3,})[ \\t]*(?i:eyg)[ \\t]*$",
      "end": "^[ \\t]*\\1`*[ \\t]*$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.fenced.markdown" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(?![ \\t]*`{3,}[ \\t]*$)",
          "while": "(^|\\G)(?![ \\t]*`{3,}[ \\t]*$)",
          "patterns": [{ "include": "source.eyg" }]
        }
      ]
    },
    {
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.eyg",
      "begin": "^[ \\t]*(~{3,})[ \\t]*(?i:eyg)[ \\t]*$",
      "end": "^[ \\t]*\\1~*[ \\t]*$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.fenced.markdown" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(?![ \\t]*~{3,}[ \\t]*$)",
          "while": "(^|\\G)(?![ \\t]*~{3,}[ \\t]*$)",
          "patterns": [{ "include": "source.eyg" }]
        }
      ]
    }
  ]
}
