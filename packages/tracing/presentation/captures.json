eal model inference.\nlet http = import \"./http.eyg\"\nlet port = http.port({})\nlet plan = http.require_ok(http.get(port, \"/plan\"))\nlet _ = perform StandardOut(plan)\nlet tool = http.require_ok(http.get(port, \"/tool\"))\nlet _ = perform StandardOut(tool)\nlet answer = http.require_ok(http.get(port, \"/answer\"))\nperform StandardOut(answer)\n","otlp":{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"eyg-02-http-workflow"}},{"key":"eyg.trace.mode","value":{"stringValue":"effects"}}]},"scopeSpans":[{"scope":{"name":"eyg.loam"},"spans":[{"traceId":"94e64f20c0eac1b5b21fd411683c6c7f","spanId":"1f29bb04dfac489b","name":"eyg.run","kind":1,"startTimeUnixNano":"1792034982047788365","endTimeUnixNano":"1792034982416496470","status":{"code":1},"attributes":[]},{"traceId":"94e64f20c0eac1b5b21fd411683c6c7f","spanId":"c5e4f6a20300f3b3","name":"eyg.eval","kind":1,"startTimeUnixNano":"1792034982061551554","endTimeUnixNano":"1792034982414287819","status":{"code":1},"attributes":[{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/examples/02-http-workflow.eyg"}}],"parentSpanId":"1f29bb04dfac489b"},{"traceId":"94e64f20c0eac1b5b21fd411683c6c7f","spanId":"669f5b208e78f8b8","name":"eyg.effect.Env","kind":1,"startTimeUnixNano":"1792034982072860062","endTimeUnixNano":"1792034982073322027","status":{"code":1},"attributes":[{"key":"eyg.profile.kind","value":{"stringValue":"effect"}},{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/examples/http.eyg"}}],"parentSpanId":"c5e4f6a20300f3b3"},{"traceId":"94e64f20c0eac1b5b21fd411683c6c7f","spanId":"08ea618667fe727a","name":"eyg.effect.Fetch","kind":1,"startTimeUnixNano":"1792034982075989117","endTimeUnixNano":"1792034982156940236","status":{"code":1},"attributes":[{"key":"eyg.profile.kind","value":{"stringValue":"effect"}},{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/exam