parentSpanId":"ff2d319b59fb77c2"},{"traceId":"21a68dd468d1f59806769c6951f25db4","spanId":"41209813dbf95d63","name":"eyg.effect.ReadFile","kind":1,"startTimeUnixNano":"1792034983003526571","endTimeUnixNano":"1792034983004494976","status":{"code":1},"attributes":[{"key":"eyg.profile.kind","value":{"stringValue":"effect"}},{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/examples/04-recovered-error.eyg"}}],"parentSpanId":"ff2d319b59fb77c2"},{"traceId":"21a68dd468d1f59806769c6951f25db4","spanId":"007e072cc0f9b013","name":"eyg.effect.StandardOut","kind":1,"startTimeUnixNano":"1792034983006325658","endTimeUnixNano":"1792034983007287644","status":{"code":1},"attributes":[{"key":"eyg.profile.kind","value":{"stringValue":"effect"}},{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/examples/04-recovered-error.eyg"}}],"parentSpanId":"ff2d319b59fb77c2"}]}]}]},"delay":0,"traceId":"21a68dd468d1f59806769c6951f25db4","requests":[]},{"id":"05-failed-run","title":"When the whole run fails","exit":1,"stdout":"Beginning a task that will fail\n","stderr":"error: Aborted with reason: \"demo: task could not be completed\"\nhint: handle the abort effect or avoid performing it in this runtime\n\n→ in /home/corin/mono/repos/eyg-lang/packages/tracing/examples/05-failed-run.eyg:5\n 5 | perform Abort(\"demo: task could not be completed\")\n     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n","source":"// Abort terminates evaluation. The root and evaluation spans become errors.\n// Abort itself has no computer-harness implementation, so it has no effect span.\nlet _ = perform StandardOut(\"Beginning a task that will fail\\n\")\nlet _ = perform Sleep(50)\nperform Abort(\"demo: task could not be completed\")\n","otlp":{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"eyg-05-failed-run"}},{"key":"eyg.trace.mode","value":{"stringValue":"effects"}}]},"scopeSpans":[{"sc