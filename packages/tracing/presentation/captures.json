butes":[{"key":"eyg.profile.kind","value":{"stringValue":"effect"}},{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/examples/http.eyg"}}],"parentSpanId":"6f4aab69e4be500a"},{"traceId":"b1ee08dee64b3c631dc329222352f0ba","spanId":"3fa2d2d895ba4424","name":"eyg.effect.StandardOut","kind":1,"startTimeUnixNano":"1792034982805495161","endTimeUnixNano":"1792034982805775962","status":{"code":1},"attributes":[{"key":"eyg.profile.kind","value":{"stringValue":"effect"}},{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/examples/03-retry.eyg"}}],"parentSpanId":"6f4aab69e4be500a"}]}]}]},"delay":0,"traceId":"b1ee08dee64b3c631dc329222352f0ba","requests":[{"path":"/unavailable","status":503},{"path":"/answer","status":200}]},{"id":"04-recovered-error","title":"A failed effect. A successful run.","exit":0,"stdout":"Read failed; using the fallback\nRecovered successfully from the failed read.\n","stderr":"","source":"// Reading a directory as a file fails deterministically.\n// The effect span is red, but handling its Error keeps the run successful.\nlet text = match perform ReadFile({path: \"./fixtures\", offset: 0, limit: 1024}) {\n  Ok(_) -> { !never(perform Abort(\"expected the directory read to fail\")) }\n  Error(_) -> {\n    let _ = perform StandardOut(\"Read failed; using the fallback\\n\")\n    let _ = perform Sleep(60)\n    match perform ReadFile({path: \"./fixtures/fallback.txt\", offset: 0, limit: 1024}) {\n      Ok(bytes) -> {\n        match !string_from_binary(bytes) {\n          Ok(text) -> { text }\n          Error(_) -> { !never(perform Abort(\"fallback was not UTF-8\")) }\n        }\n      }\n      Error(reason) -> { !never(perform Abort(reason)) }\n    }\n  }\n}\nperform StandardOut(text)\n","otlp":{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"eyg-04-recovered-error"}},{"key":"eyg.trace.mode","value":{"stringValue":"effects"}}]},"scop