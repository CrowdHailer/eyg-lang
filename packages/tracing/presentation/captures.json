no":"1792034982414016993","status":{"code":1},"attributes":[{"key":"eyg.profile.kind","value":{"stringValue":"effect"}},{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/examples/02-http-workflow.eyg"}}],"parentSpanId":"c5e4f6a20300f3b3"}]}]}]},"delay":0,"traceId":"94e64f20c0eac1b5b21fd411683c6c7f","requests":[{"path":"/plan","status":200},{"path":"/tool","status":200},{"path":"/answer","status":200}]},{"id":"03-retry","title":"The shape of a retry","exit":0,"stdout":"HTTP 503; waiting before retry\nAnswer: trace the effects, then inspect the run\n","stderr":"","source":"// An HTTP response is a successful Fetch, even when its status is 503.\n// The application decides to retry; the backoff is visible as a Sleep span.\nlet http = import \"./http.eyg\"\nlet port = http.port({})\nlet first = http.get(port, \"/unavailable\")\nmatch !equal(first.status, 503) {\n  True(_) -> {\n    let _ = perform StandardOut(\"HTTP 503; waiting before retry\\n\")\n    let _ = perform Sleep(100)\n    let answer = http.require_ok(http.get(port, \"/answer\"))\n    perform StandardOut(answer)\n  }\n  False(_) -> { !never(perform Abort(\"expected the demo's HTTP 503\")) }\n}\n","otlp":{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"eyg-03-retry"}},{"key":"eyg.trace.mode","value":{"stringValue":"effects"}}]},"scopeSpans":[{"scope":{"name":"eyg.loam"},"spans":[{"traceId":"b1ee08dee64b3c631dc329222352f0ba","spanId":"5534abe83659517b","name":"eyg.run","kind":1,"startTimeUnixNano":"1792034982509073447","endTimeUnixNano":"1792034982806960783","status":{"code":1},"attributes":[]},{"traceId":"b1ee08dee64b3c631dc329222352f0ba","spanId":"6f4aab69e4be500a","name":"eyg.eval","kind":1,"startTimeUnixNano":"1792034982539734409","endTimeUnixNano":"1792034982805972939","status":{"code":1},"attributes":[{"key":"eyg.source","value":{"stringValue":"/home/corin/mono/repos/eyg-lang/packages/tracing/examples/03-retry.eyg"}}],"par