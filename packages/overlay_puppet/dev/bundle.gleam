//// Embed generated browser bundles in Gleam constants, so srcdoc needs no network access.

import gleam/io
import gleam/javascript/promise
import gleam/json
import gleam/string
import plinthx/bun/bundle
import plinthx/bun/runtime
import simplifile

pub fn main() {
  let assert Ok(bun) = runtime.get()
  use puppet <- promise.await(compile(bun, "overlay/puppet", "puppet"))
  use relay <- promise.await(compile(bun, "overlay/puppet/relay", "relay"))
  use isolation <- promise.await(compile(bun, "isolation", "isolation"))
  let assert Ok(_) = simplifile.write("build/preview/isolation.js", isolation)
  use carousel <- promise.await(compile(
    bun,
    "overlay/viewer/carousel",
    "carousel",
  ))
  use video <- promise.await(compile(bun, "overlay/viewer/video", "video"))
  use bluesky <- promise.map(compile(bun, "overlay/viewer/bluesky", "bluesky"))
  let viewers =
    "// Generated from packages/overlay_puppet/src/overlay/viewer by the Gleam bundler.\n{carousel: "
    <> literal(carousel)
    <> ", video: "
    <> literal(video)
    <> ", bluesky: "
    <> literal(bluesky)
    <> "}\n"
  let assert Ok(_) =
    simplifile.write("../../eyg_packages/artifact_viewers/runtime.eyg", viewers)
  let generated =
    "//// Generated by packages/overlay_puppet/dev/bundle.gleam. Edit the Gleam sources.\n\npub const script =\n  "
    <> literal(puppet)
    <> "\n\npub const relay =\n  "
    <> literal(relay)
    <> "\n"
  let assert Ok(_) =
    simplifile.write(
      "../overlay_public/src/overlay/public/puppet.gleam",
      generated,
    )
  io.println("Generated artifact preview driver and relay")
}

fn compile(bun, module, name) {
  let assert Ok(_) = simplifile.create_directory_all("build/preview")
  let entry = "build/preview/" <> name <> ".mjs"
  // This generated entry only starts the compiled Gleam module.
  let assert Ok(_) =
    simplifile.write(
      entry,
      "import { main } from '../dev/javascript/overlay_puppet/"
        <> module
        <> ".mjs';\nmain();\n",
    )
  let options =
    json.object([
      #("entrypoints", json.array([entry], json.string)),
      #("target", json.string("browser")),
      #("format", json.string("iife")),
      #("minify", json.bool(True)),
    ])
    |> json.to_string
  use built <- promise.await(bundle.build(bun, options))
  let assert Ok(built) = built
  let assert True = bundle.success(built)
    as string.join(bundle.logs(built), "\n")
  let assert [output] = bundle.outputs(built)
  bundle.text(output)
}

fn literal(source) {
  // Prevent a script's HTML terminator in generated constants, including runtime helpers.
  source |> string.replace("</", "<\\/") |> json.string |> json.to_string
}
