---
version: 2.0.2
title: large effectful function breaks across lines
---
(
  {path: String, bytes: Binary}
  <
    ReadFile(↑String ↓[
      Ok: Binary |
      Error: String
    ]),
    DecodeJSON(↑Binary ↓[
      Ok: List(
        [
          Variable: String |
          Lambda: String |
          Apply: {} |
          Let: String |
          Binary: Binary |
          Integer: Integer |
          String: String |
          Tail: {} |
          Cons: {} |
          Vacant: {} |
          Empty: {} |
          Extend: String |
          Select: String |
          Overwrite: String |
          Tag: String |
          Case: String |
          NoCases: {} |
          Perform: String |
          Handle: String |
          Builtin: String |
          Reference: [
            Content: String |
            Package: String |
            Version: {
              package: String,
              version: Integer,
            } |
            Pinned: {
              package: String,
              version: Integer,
              cid: String,
            } |
            Relative: String
          ]
        ]
      ) |
      Error: String
    ]),
    ..7
  >,
) -> Promise(
  List(
    {
      key: String,
      value: List(
        [
          Variable: String |
          Lambda: String |
          Apply: {} |
          Let: String |
          Binary: Binary |
          Integer: Integer |
          String: String |
          Tail: {} |
          Cons: {} |
          Vacant: {} |
          Empty: {} |
          Extend: String |
          Select: String |
          Overwrite: String |
          Tag: String |
          Case: String |
          NoCases: {} |
          Perform: String |
          Handle: String |
          Builtin: String |
          Reference: [
            Content: String |
            Package: String |
            Version: {
              package: String,
              version: Integer,
            } |
            Pinned: {
              package: String,
              version: Integer,
              cid: String,
            } |
            Relative: String
          ]
        ]
      ),
    }
  )
)
