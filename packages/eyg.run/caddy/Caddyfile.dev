{$AUTHORITY} {
	handle /modules/* {
		reverse_proxy backend:8080
	}
	handle /packages/* {
		reverse_proxy backend:8080
	}
	handle /signatories/* {
		reverse_proxy backend:8080
	}
	handle /proxy/* {
		reverse_proxy backend:8080
	}
	handle /overlay {
		redir * /overlay/
	}
	handle /overlay/* {
		reverse_proxy overlay:5173
	}
	handle /api/chat {
		reverse_proxy https://ollama.com {
			header_up Host ollama.com
		}
	}
	handle {
		header Access-Control-Allow-Origin "*"
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		format console
		level {$LOG_LEVEL:INFO}
	}
}
