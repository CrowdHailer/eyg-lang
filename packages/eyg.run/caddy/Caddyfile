{$AUTHORITY} {
	handle /modules/* {
		reverse_proxy backend:8080
	}
	handle /packages/* {
		reverse_proxy backend:8080
	}
	handle /signatories/* {
		reverse_proxy backend:8080
	}
	handle /proxy/* {
		reverse_proxy backend:8080
	}
	handle /install {
		redir https://raw.githubusercontent.com/CrowdHailer/eyg-lang/main/install.sh
	}
	handle /overlay {
		redir * /overlay/
	}
	handle /api/chat {
		reverse_proxy https://ollama.com {
			header_up Host ollama.com
		}
	}
	handle_path /overlay/* {
		root * /var/overlay
		try_files {path} {path}/index.html /index.html
		file_server
	}

	handle {
		root * /var/eyg
		header Access-Control-Allow-Origin "*"
		try_files {path} {path}/index.html /index.html
		file_server
	}

	log {
		output stdout
		format console
		level {$LOG_LEVEL:INFO}
	}
}
