// Paths are normalized and absolute before the policy is called.
// Every effect is allowed, skills in /skills can be written as any other file.
let pass = (input) -> { Pass(input) }
{
  append_file: pass,
  cwd: pass,
  delete_file: pass,
  env: pass,
  fetch: pass,
  flip: pass,
  make_directory: pass,
  now: pass,
  random: pass,
  read_directory: pass,
  read_file: pass,
  sleep: pass,
  standard_error: pass,
  standard_out: pass,
  write_file: pass
}
