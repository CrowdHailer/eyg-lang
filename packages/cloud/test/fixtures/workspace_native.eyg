let cloud = import "../../../../eyg_packages/cloud/index.eyg"

{
  llm: {
    provider: Ollama({origin: "http://localhost:11434", api_key: None({})}),
    model: "test-model"
  },
  files: "./files",
  channel: ({name}) -> {
    {
      handle: (event) -> {
        match event.own {
          True(_) -> { [] }
          False(_) -> {
            let description = !list_fold(
              ["[#", name, "] alice (message ", event.id, "): ", event.text],
              "",
              (part, text) -> { !string_append(text, part) }
            )
            [Submit({session: None({}), reply: Some(event.id), text: event.text, description})]
          }
        }
      },
      channel_shell: match !equal(name, "notes") {
        True(_) -> { cloud.shell.writes_under(["/channels/notes"], cloud.shell.everything) }
        False(_) -> { cloud.shell.everything }
      }
    }
  }
}
