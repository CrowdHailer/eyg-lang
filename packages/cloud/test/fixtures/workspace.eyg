let cloud = import "../../../../eyg_packages/cloud/index.eyg"
let shell = cloud.shell

let books = {
  name: "summarise-links",
  pattern: cloud.triggers.reaction("books"),
  script: "match event {\n  ChatReacted(reacted) -> { perform Post(!string_append(\"summary of \", reacted.message.text)) }\n  | (_) -> { Error(\"not a reaction\") }\n}"
}

let research = {
  name: "research",
  pattern: match {
    ChatPosted(posted) -> { !string_starts_with(posted.text, "research:") }
    | (_) -> { False({}) }
  },
  script: match {
    ChatPosted(posted) -> {
      match perform Delegate(posted.text) {
        Ok(reply) -> { perform Post(reply) }
        Error(reason) -> { perform Post(reason) }
      }
    }
    | (_) -> { Error("not a message") }
  }
}

let issues = {
  name: "new-issues",
  pattern: cloud.triggers.issue_opened,
  script: match {
    GitHubIssue(issue) -> { perform Post(!string_append("New issue: ", issue.title)) }
    | (_) -> { Error("not an issue") }
  }
}

{
  llm: {
    provider: Ollama({origin: "http://localhost:11434", api_key: None({})}),
    model: "test-model"
  },
  readme: "The test workspace.",
  files: "./files",
  connections: [{name: "github", source: GitHub({repositories: [], secret: "s3cret", every: 0}), channel: "general"}],
  channel: ({name}) -> {
    match !equal(name, "general") {
      True(_) -> { {handle: ({text}) -> { [Post({thread: None({}), text})] }, channel_shell: shell.everything, readme: "Be helpful.", triggers: [books, research, issues]} }
      False(_) -> {
        match !equal(name, "notes") {
          True(_) -> { {handle: (_) -> { [] }, channel_shell: shell.writes_under(["/channels/notes"], shell.everything)} }
          False(_) -> {
            {
              handle: (_) -> { [] },
              channel_shell: {post: shell.pass, ..cloud.reject_all},
              llm: {provider: Mistral({api_key: "k"}), model: "small"}
            }
          }
        }
      }
    }
  }
}
