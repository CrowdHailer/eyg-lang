let cloud = import "../../../../eyg_packages/cloud/index.eyg"
let shell = cloud.shell
let secrets = cloud.secrets

let token = match secrets.load("GITHUB_TOKEN", ["api.github.com"]) {
  Ok(token) -> { token }
  Error(reason) -> { !never(perform Abort(reason)) }
}

{
  llm: {provider: Ollama({origin: "http://localhost:11434", api_key: None({})}), model: "test"},
  channel: (_) -> {
    {
      handle: (_) -> { [] },
      channel_shell: {
        env: secrets.env([token]),
        fetch: secrets.fetch([token], shell.pass),
        ..shell.everything
      }
    }
  }
}
