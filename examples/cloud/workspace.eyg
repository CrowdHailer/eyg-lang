// An example EYG cloud workspace, see README.md.
let cloud = import "../../eyg_packages/cloud/index.eyg"
let shell = cloud.shell
let triggers = cloud.triggers
let secrets = cloud.secrets

// The model's key is only read here, agents never see it.
let api_key = match perform Secret("OLLAMA_API_KEY") {
  Ok(key) -> { Some(key) }
  Error(_) -> { None({}) }
}

// Network secrets: programs see a placeholder from Env,
// requests to httpbin.org get the real value.
let network = match secrets.load("DEMO_TOKEN", ["httpbin.org"]) {
  Ok(token) -> { [token] }
  Error(_) -> { [] }
}

let online = (base) -> {
  {env: secrets.env(network), fetch: secrets.fetch(network, shell.pass), ..base}
}

let post = (parts) -> { perform Post(!list_fold(parts, "", (part, text) -> { !string_append(text, part) })) }

// React with :books: to a message with links to get a summary in its thread.
let summarise_links = {
  name: "summarise-links",
  pattern: (event) -> {
    match triggers.reaction("books")(event) {
      True(_) -> { True({}) }
      False(_) -> { triggers.reaction("📚")(event) }
    }
  },
  script: (event) -> {
    let text = match event {
      ChatReacted(event) -> { Some(event.message.text) }
      SlackReaction(event) -> { Some(event.message.text) }
      DiscordReaction(event) -> { Some(event.message.content) }
      WhatsAppMessage(event) -> {
        match event.referenced {
          Some(message) -> {
            match message.content {
              Text(text) -> { Some(text) }
              Media(media) -> { Some(media.caption) }
              | (_) -> { None({}) }
            }
          }
          None(_) -> { None({}) }
        }
      }
      | (_) -> { None({}) }
    }
    match text {
      Some(text) -> {
        let task = !string_append("Fetch each link in this message and post a two sentence summary of each link. Message: ", text)
        match perform Delegate(task) {
          Ok(_) -> { {} }
          Error(reason) -> { let _ = post(["Could not summarise the links: ", reason]) {} }
        }
      }
      None(_) -> { {} }
    }
  }
}

// GitHub events go to #dev. GitHub is not a chat, nothing posted on GitHub runs code,
// its events only reach these triggers.
let github_triggers = [
  {
    name: "triage-issues",
    pattern: triggers.issue_opened,
    script: match {
      GitHubIssue(issue) -> {
        let task = !string_append(
          "A GitHub issue was opened. Post one message: the issue number, title and url, a one line summary and a suggested label. Issue: ",
          !string_append(issue.title, !string_append(" ", !string_append(issue.url, !string_append(" ", issue.body))))
        )
        match perform Delegate(task) {
          Ok(_) -> { {} }
          Error(_) -> { post(["New issue: ", issue.url]) }
        }
      }
      | (_) -> { {} }
    }
  },
  {
    name: "merged",
    pattern: triggers.pull_request_merged,
    script: match {
      GitHubPullRequest(pull) -> { post(["🎉 Merged: ", pull.title, " by ", pull.actor, " ", pull.url]) }
      | (_) -> { {} }
    }
  },
  {
    name: "stars",
    pattern: match { GitHubStar(_) -> { True({}) } | (_) -> { False({}) } },
    script: match {
      GitHubStar(star) -> { post(["⭐ ", star.actor, " starred ", star.repository]) }
      | (_) -> { {} }
    }
  },
  {
    name: "ci-failed",
    pattern: match {
      GitHubWorkflowRun(run) -> {
        match !equal(run.conclusion, "failure") {
          True(_) -> { !equal(run.branch, "main") }
          False(_) -> { False({}) }
        }
      }
      | (_) -> { False({}) }
    },
    script: match {
      GitHubWorkflowRun(run) -> { post(["❌ ", run.name, " failed on main ", run.url]) }
      | (_) -> { {} }
    }
  }
]

// Stories about the languages we use go to #news.
let news_triggers = [
  {
    name: "gleam-news",
    pattern: (event) -> {
      match triggers.title_contains("gleam")(event) {
        True(_) -> { True({}) }
        False(_) -> { triggers.title_contains("erlang")(event) }
      }
    },
    script: match {
      FeedItem(item) -> { post(["📰 ", item.title, " ", item.link]) }
      HackerNewsStory(story) -> { post(["📰 ", story.title, " ", story.link]) }
      LobstersStory(story) -> { post(["📰 ", story.title, " ", story.link]) }
      | (_) -> { {} }
    }
  }
]

// When Gleam posts on Bluesky, say how many of its posts are in the log.
// The script reads the connection's event log with the Events effect.
let social_triggers = [
  {
    name: "gleam-posts",
    pattern: match {
      BskyPost(post) -> { !equal(post.account, "gleam.run") }
      | (_) -> { False({}) }
    },
    script: match {
      BskyPost(bsky) -> {
        let seen = match perform Events("bsky") {
          Ok(events) -> {
            !list_fold(events, 0, (event, count) -> {
              match event {
                BskyPost(other) -> {
                  match !equal(other.account, bsky.account) {
                    True(_) -> { !int_add(count, 1) }
                    False(_) -> { count }
                  }
                }
                | (_) -> { count }
              }
            })
          }
          Error(_) -> { 0 }
        }
        post(["🦋 @gleam.run posted, ", !int_to_string(seen), " of their posts are in the log: ", bsky.url])
      }
      | (_) -> { {} }
    }
  }
]

// Webhooks are accepted when a secret is saved, the repository is also polled every minute.
let repositories = ["CrowdHailer/eyg-lang"]
let github = match perform Secret("GITHUB_WEBHOOK_SECRET") {
  Ok(secret) -> { GitHub({repositories, secret, every: 60}) }
  Error(_) -> { GitHub({repositories, every: 60}) }
}

{
  llm: {
    provider: Ollama({origin: "https://ollama.com", api_key}),
    model: "glm-5.3"
  },
  readme: "This is the example workspace of the EYG team. Be brief, friendly and helpful.",
  files: "./files",
  connections: [
    {name: "chat", source: ExampleChat({origin: "http://localhost:8080"})},
    {name: "github", source: github, channel: "dev"},
    {
      name: "bsky",
      source: Bsky({
        actors: ["gleam.run"],
        feeds: ["at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.feed.generator/whats-hot"],
        every: 30
      }),
      channel: "social"
    },
    {name: "blogs", source: Rss({feeds: ["https://gleam.run/feed.xml", "https://erlangforums.com/latest.rss"]}), channel: "news"},
    {name: "hn", source: HackerNews({lists: ["top", "new"], every: 60}), channel: "news"},
    {name: "lobsters", source: Lobsters({lists: ["newest"]}), channel: "news"}
  ],
  crons: [
    {
      name: "standup",
      schedule: "0 9 * * 1-5",
      channel: "general",
      message: "It is 9am UTC. If people were active yesterday, post a one line standup reminder."
    }
  ],
  // Each channel's shell is the policy for everything run from it.
  channel: cloud.channels.named([
    {
      name: "general",
      config: (info) -> { {
        handle: cloud.handlers.for_channel(info),
        channel_shell: online(shell.writes_under(["/channels/general", "/skills"], shell.everything)),
        readme: "The team's main channel, answer questions when people ask you."
      } }
    },
    {
      name: "links",
      config: (info) -> { {
        handle: cloud.handlers.for_channel(info),
        channel_shell: online(shell.writes_under(["/channels/links"], shell.everything)),
        readme: "People share links here. Only post when someone asks you something.",
        triggers: [summarise_links]
      } }
    },
    {
      name: "dev",
      config: (info) -> { {
        handle: cloud.handlers.for_channel(info),
        channel_shell: online(shell.writes_under(["/channels/dev"], shell.everything)),
        readme: "Development of eyg-lang, GitHub events arrive here through triggers.",
        triggers: github_triggers
      } }
    },
    {
      name: "news",
      config: (info) -> { {
        handle: cloud.handlers.for_channel(info),
        channel_shell: online(shell.writes_under(["/channels/news"], shell.everything)),
        readme: "Stories from feeds, Hacker News and Lobsters arrive here through triggers.",
        triggers: news_triggers
      } }
    },
    {
      name: "social",
      config: (info) -> { {
        handle: cloud.handlers.for_channel(info),
        channel_shell: online(shell.writes_under(["/channels/social"], shell.everything)),
        readme: "Bluesky posts arrive here through triggers.",
        triggers: social_triggers
      } }
    },
    {
      name: "founders",
      config: (info) -> { {
        handle: cloud.handlers.for_channel(info),
        channel_shell: online(shell.admin),
        readme: "The founders run the cloud from here. You can read and change its configuration with the configuration API effects, Workspaces, WorkspaceSource, Channels, Connections, WorkspaceTriggers, Secrets, Users, Shells and Traces, and their Set and Delete forms. Never print secret values. This cloud's workspace is called example."
      } }
    }
  ], (info) -> {
    {
      handle: cloud.handlers.for_channel(info),
      channel_shell: shell.writes_under([!string_append("/channels/", info.name)], shell.offline),
      readme: "This channel has no network access."
    }
  })
}
