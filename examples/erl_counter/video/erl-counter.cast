[22.8716, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[J(eyg_counters_video@LLaptopy)3> Script = \"\r\n                                @standard.list.map([\\\"apples\\\", \\\"pears\\\", \\\"plums\\\"], (name) -> {\r\n                                  let _ = perform StartCounter(name)\r\n                                  perform SetTickRate({name: name, seconds: 1})\r\n                                })\r\n                                \", ok.\r\n"]
